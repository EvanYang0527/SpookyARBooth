# Server
PORT=3001

# JWT — generate a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret

# Initial admin account (created on first startup if not already in Table Storage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-image-2.5-flare
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure Storage (Blob + Table — same account)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=photos

# Set to "true" to require a login token for the /api/effects/apply endpoint
REQUIRE_AUTH=false

# CORS origins for local development (comma-separated)
# Not needed in production when frontend is served by this server
CORS_ORIGINS=http://localhost:5173
